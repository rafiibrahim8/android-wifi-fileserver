<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WiFiFileServer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.WiFiFileServer.Large</item>
    </style>

    <style name="ShapeAppearance.WiFiFileServer.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">26dp</item>
    </style>
</resources>
