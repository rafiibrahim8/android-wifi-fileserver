# Copy this file to keystore.properties (which is gitignored) and fill in real
# values. The path is relative to the repo root.
#
# Generate the keystore once with:
#   keytool -genkeypair -v \
#     -keystore upload.jks \
#     -alias key0 \
#     -keyalg RSA -keysize 4096 -validity 36500 \
#     -storetype PKCS12
# Move upload.jks to a safe location outside the repo (or keep at the root —
# it is gitignored). Back it up: losing the upload key is recoverable via Play,
# but only if you can prove your identity to Google.

storeFile=upload.jks
storePassword=CHANGE_ME
keyAlias=key0
keyPassword=CHANGE_ME
